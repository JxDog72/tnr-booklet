<Window x:Class="Focus.Views.ReminderAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TNR-Booklet reminder"
        Width="500"
        SizeToContent="Height"
        MinWidth="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgAppBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="SnoozeError"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Remind me in"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Hours"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11"
                       Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="HourMinus" Content="−" Style="{DynamicResource ChipButton}"
                        MinWidth="32" Padding="8,5" Click="HourMinus_Click"
                        ToolTip="One hour less"/>
                <TextBlock x:Name="HourValue"
                           Text="0"
                           Width="36"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <Button x:Name="HourPlus" Content="+" Style="{DynamicResource ChipButton}"
                        MinWidth="32" Padding="8,5" Click="HourPlus_Click"
                        ToolTip="One hour more"/>
            </StackPanel>
            <WrapPanel x:Name="HourChips" Margin="0,0,0,4"/>

            <TextBlock Text="Minutes"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11"
                       Margin="0,8,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="MinuteMinus" Content="−" Style="{DynamicResource ChipButton}"
                        MinWidth="32" Padding="8,5" Click="MinuteMinus_Click"
                        ToolTip="One minute less"/>
                <TextBlock x:Name="MinuteValue"
                           Text="5"
                           Width="36"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <Button x:Name="MinutePlus" Content="+" Style="{DynamicResource ChipButton}"
                        MinWidth="32" Padding="8,5" Click="MinutePlus_Click"
                        ToolTip="One minute more"/>
            </StackPanel>
            <WrapPanel x:Name="MinuteChips" Margin="0,0,0,10"/>

            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                <TextBlock x:Name="SnoozeSummary"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,12,0"/>
                <Button Content="Remind me"
                        Style="{DynamicResource AccentButton}"
                        Padding="14,6"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsDefault="True"
                        Click="Snooze_Click"/>
            </DockPanel>

            <Button Content="Dismiss"
                    Style="{DynamicResource FocusButton}"
                    HorizontalAlignment="Right"
                    Width="96"
                    IsCancel="True"
                    Click="Dismiss_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>
            <TextBlock x:Name="BodyText"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       MaxHeight="180"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </DockPanel>
</Window>
