<Window x:Class="Focus.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — TNR-Booklet"
        Height="720" Width="560"
        MinHeight="520" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgAppBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       MaxWidth="280"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Test send" Style="{DynamicResource FocusButton}" Width="100" Margin="0,0,8,0" Click="Test_Click"/>
                <Button Content="Save" Style="{DynamicResource AccentButton}" Width="96" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
                <Button Content="Close" Style="{DynamicResource FocusButton}" Width="96" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" PanningMode="VerticalOnly">
            <StackPanel>
                <!-- Data folder -->
                <Border Style="{DynamicResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="📁  Data folder" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Todos, notes, settings, and themes on this PC"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10"/>
                        <TextBox Text="{Binding DataFolderPath, Mode=OneWay}"
                                 Style="{DynamicResource FocusTextBox}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"/>
                        <TextBlock Text="{Binding DataFolderHint}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,6,0,8"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Change folder…" Style="{DynamicResource FocusButton}"
                                    Padding="12,6" Margin="0,0,8,0" Click="ChangeDataFolder_Click"/>
                            <Button Content="Open folder" Style="{DynamicResource FocusButton}"
                                    Padding="12,6" Margin="0,0,8,0" Click="OpenDataFolder_Click"/>
                            <Button Content="Use default" Style="{DynamicResource FocusButton}"
                                    Padding="12,6" Click="DefaultDataFolder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notifications -->
                <Border Style="{DynamicResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="🔔  Notifications" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="How reminders reach you on this PC"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10"/>
                        <CheckBox Content="Toast (Windows notification)" IsChecked="{Binding ToastEnabled}" Style="{DynamicResource FocusCheckBox}"/>
                        <CheckBox Content="Sound alert" IsChecked="{Binding SoundEnabled}" Style="{DynamicResource FocusCheckBox}"/>
                        <CheckBox Content="Popup focus (bring TNR-Booklet to front)" IsChecked="{Binding PopupFocusEnabled}" Style="{DynamicResource FocusCheckBox}"/>
                        <CheckBox Content="Show system tray icon" IsChecked="{Binding TrayEnabled}" Style="{DynamicResource FocusCheckBox}"/>
                        <CheckBox Content="Close window to tray (stay running)" IsChecked="{Binding CloseToTray}" Style="{DynamicResource FocusCheckBox}"/>
                        <CheckBox Content="Pause all notifications" IsChecked="{Binding NotificationsPaused}" Style="{DynamicResource FocusCheckBox}"/>
                        <TextBlock Text="Optional sound file (.wav)" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,4"/>
                        <TextBox Text="{Binding SoundPath, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource FocusTextBox}"/>
                    </StackPanel>
                </Border>

                <!-- Task Scheduler -->
                <Border Style="{DynamicResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="🗓  Windows Task Scheduler" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Fire reminders even when TNR-Booklet is closed"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10"/>
                        <CheckBox Content="Register scheduled reminders" IsChecked="{Binding TaskSchedulerEnabled}" Style="{DynamicResource FocusCheckBox}"/>
                        <CheckBox Content="Wake computer to run reminder" IsChecked="{Binding WakeToRun}" Style="{DynamicResource FocusCheckBox}"/>
                    </StackPanel>
                </Border>

                <!-- Telegram -->
                <Border Style="{DynamicResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="✈  Telegram" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10"
                                   Text="1) Message @BotFather → /newbot → copy token&#x0a;2) Open your bot and press Start&#x0a;3) Get chat id (e.g. @userinfobot) and paste below"/>
                        <CheckBox Content="Enable Telegram messaging" IsChecked="{Binding TelegramEnabled}" Style="{DynamicResource FocusCheckBox}"/>
                        <TextBlock Text="Bot token" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,4"/>
                        <PasswordBox x:Name="TelegramTokenBox"
                                     Style="{DynamicResource FocusPasswordBox}"
                                     PasswordChanged="TelegramToken_PasswordChanged"/>
                        <TextBlock Text="Chat id" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource FocusTextBox}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0"
                                   Text="Token stays on this PC. JSON export does not include it."/>
                    </StackPanel>
                </Border>

                <!-- Discord -->
                <Border Style="{DynamicResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="💬  Discord" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10"
                                   Text="Server Settings → Integrations → Webhooks → New Webhook → Copy URL into a private channel."/>
                        <CheckBox Content="Enable Discord messaging" IsChecked="{Binding DiscordEnabled}" Style="{DynamicResource FocusCheckBox}"/>
                        <TextBlock Text="Webhook URL" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,4"/>
                        <PasswordBox x:Name="DiscordWebhookBox"
                                     Style="{DynamicResource FocusPasswordBox}"
                                     PasswordChanged="DiscordWebhook_PasswordChanged"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0"
                                   Text="Webhook stays on this PC. JSON export does not include it (enabled flags are kept)."/>
                        <CheckBox Content="Also send a message when a reminder fires"
                                  IsChecked="{Binding MessagingOnReminder}"
                                  Style="{DynamicResource FocusCheckBox}"
                                  Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
