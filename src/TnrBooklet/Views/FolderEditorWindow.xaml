<Window x:Class="Focus.Views.FolderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="280" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgAppBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ResizeMode="NoResize">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="96" Margin="0,0,8,0" Style="{DynamicResource AccentButton}" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="96" Style="{DynamicResource FocusButton}" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Folder name" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource FocusTextBox}" Margin="0,0,0,16"/>

            <TextBlock Text="Color" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
            <DockPanel>
                <Border Width="48" Height="48" CornerRadius="8" Background="{Binding ColorBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ColorHex}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <Button Content="Choose color…" Style="{DynamicResource FocusButton}" HorizontalAlignment="Left" Click="PickColor_Click"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="Presets, RGB sliders, or full color wheel"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,12,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
